{
  "name": "highmap-wasm",
  "version": "0.1.0",
  "description": "WebAssembly port of the HighMap terrain generation library (CPU-only), usable from Node and the browser",
  "type": "module",
  "license": "LGPL-2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mode777/highmap-wasm.git"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build:js": "node scripts/build-js.mjs",
    "build": "bash scripts/build-wasm.sh && node scripts/build-js.mjs",
    "bench": "node scripts/bench.mjs",
    "check": "tsc --noEmit",
    "golden:capture": "node scripts/golden-capture.mjs",
    "test": "vitest run && node scripts/test-bundler.mjs && node scripts/test-quickstart.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0"
  }
}
